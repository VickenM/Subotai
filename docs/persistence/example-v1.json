        {
          "id": "event:output:event",
          "name": "event",
          "direction": "output",
          "kind": "event",
          "binding": "event"
        },
        {
          "id": "value:input:initial",
          "name": "initial",
          "direction": "input",
          "kind": "value",
          "binding": "input:initial"
